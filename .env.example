# FreightVeil — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# ─── Frontend (Vite — safe to expose in browser) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Backend / Edge Functions (NEVER expose to browser) ──────────────────────
# Service role key — only used server-side / in Supabase Edge Functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT secret — must match your Supabase project's JWT secret (Settings → API)
# Used by the wallet-auth Edge Function to sign custom JWTs.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Midnight Deployment ──────────────────────────────────────────────────────
# BIP-39 mnemonic of a funded Midnight Preprod wallet
# Get Preprod tDUST from: https://faucet.testnet.midnight.network
MIDNIGHT_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Midnight node RPC endpoint (Preprod)
MIDNIGHT_NODE_URL=https://rpc.testnet.midnight.network

# Midnight proof-server endpoint
PROOF_SERVER_URL=https://proof-server.testnet.midnight.network

# ─── Optional: deployed contract address (filled by scripts/deploy.ts) ────────
VITE_CONTRACT_ADDRESS=0x62a27ceda5eb600263e208768d5d285c659d47f2cd6b14a20c62b160f4da46f3
